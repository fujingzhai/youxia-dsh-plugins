{
  "name": "dsh-pi-mode",
  "version": "0.5.3",
  "author": "youxia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujingzhai/youxia-dsh-plugins.git",
    "directory": "dsh-pi-mode"
  },
  "homepage": "https://github.com/fujingzhai/youxia-dsh-plugins/tree/main/dsh-pi-mode#readme",
  "bugs": {
    "url": "https://github.com/fujingzhai/youxia-dsh-plugins/issues"
  },
  "description": "DSH-Pi 提供 Pi、Pi+、Pi-IM 三种精简预设。Pi+ 支持补丁编辑和 JavaScript 工具编排。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "check": "node --check index.js && node --check web.js && node --check settings.js && node --check shell.js && node --check files.js && node --check progress.js && node --check codemode.js && node --check codemode-queue.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./web.js": "./web.js",
    "./settings.js": "./settings.js",
    "./shell.js": "./shell.js",
    "./files.js": "./files.js",
    "./progress.js": "./progress.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./codemode.js": "./codemode.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "icon.svg",
    "web.js",
    "settings.js",
    "shell.js",
    "files.js",
    "progress.js",
    "codemode.js",
    "codemode-queue.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-web": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-office": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "preset",
    "pi"
  ],
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.2"
  }
}
