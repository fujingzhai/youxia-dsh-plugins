{
  "name": "dsh-pi-mode",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 的 Pi 模式：工具与系统提示词以 pi 为蓝本（13 个工具，无子代理、目标与计划；系统提示词只有一句身份和规矩）。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "web.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-web": ">=0.2.1-rc.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "preset",
    "pi"
  ]
}
