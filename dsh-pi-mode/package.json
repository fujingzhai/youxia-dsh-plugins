{
  "name": "dsh-pi-mode",
  "version": "0.3.3",
  "author": "youxia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujingzhai/youxia-dsh-plugins.git",
    "directory": "dsh-pi-mode"
  },
