    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "check": "node --check index.js && node --check web.js && node --check settings.js && node --check shell.js && node --check files.js && node --check progress.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./web.js": "./web.js",
    "./settings.js": "./settings.js",
    "./shell.js": "./shell.js",
    "./files.js": "./files.js",
    "./progress.js": "./progress.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "icon.svg",
    "web.js",
    "settings.js",
    "shell.js",
    "files.js",
    "progress.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
