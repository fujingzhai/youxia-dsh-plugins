  "bugs": { "url": "https://github.com/fujingzhai/youxia-dsh-plugins/issues" },
  "description": "DSH 的 Pi 模式插件：精简工具与中文系统提示词，同包提供 Pi 模式、IM 版 Pi-IM 与开启官方 apply_patch 的 Pi+模式；三者共用核心定义。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check web.js && node --check settings.js && node --check shell.js && node --check files.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./web.js": "./web.js",
    "./settings.js": "./settings.js",
    "./shell.js": "./shell.js",
    "./files.js": "./files.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "icon.svg",
    "web.js",
    "settings.js",
    "shell.js",
    "files.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-web": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "preset",
    "pi"
  ]
