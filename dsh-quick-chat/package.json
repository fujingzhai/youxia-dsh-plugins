{
  "name": "dsh-quick-chat",
  "version": "0.1.2",
  "description": "DSH 主面板里的 DeepSeek 官方网页：复用原生浏览器，登录跨重启恢复。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "Apache-2.0",
  "author": "youxia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujingzhai/youxia-dsh-plugins.git",
    "directory": "dsh-quick-chat"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "webview",
    "desktop"
  ]
}
