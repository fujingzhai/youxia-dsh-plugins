{
  "name": "dsh-agents-cli",
  "version": "0.1.5",
  "description": "在 DSH 主面板中使用本机 CLI Agents：默认 Claude Code、Codex、Antigravity、Pi，支持持久终端和自定义入口。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.mjs",
    "lib/**/*.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.25.11"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "author": "youxia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujingzhai/youxia-dsh-plugins.git",
    "directory": "dsh-agents-cli"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "terminal",
    "agents",
    "claude",
    "codex",
    "antigravity",
    "pi"
  ]
}
